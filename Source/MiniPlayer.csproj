<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><GenerateAssemblyInfo>false</GenerateAssemblyInfo><AssemblyName>MiniPlayer</AssemblyName></PropertyGroup>
<PropertyGroup><ApplicationIcon>Player.ico</ApplicationIcon></PropertyGroup><ItemGroup><Content Include="Player.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup><ItemGroup><EmbeddedResource Include="../screenshots/*.png" Exclude="../screenshots/*-expanded.png;../screenshots/*preview.png"><LogicalName>preview.%(Filename)%(Extension)</LogicalName></EmbeddedResource></ItemGroup>
 <ItemGroup>
  <Compile Include="../Launcher/Source/WidgetPreset.cs" Link="Preset/WidgetPreset.cs" />
  <Compile Include="../Launcher/Source/PresetSurface.cs" Link="Preset/PresetSurface.cs" />
  <Compile Include="../Launcher/Source/PresetPreview.cs" Link="Preset/PresetPreview.cs" />
  <Content Include="Fonts/Onest-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
 </ItemGroup>
</Project>
