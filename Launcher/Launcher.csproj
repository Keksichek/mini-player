<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Launcher</AssemblyName>
    <ApplicationIcon>Launcher.ico</ApplicationIcon>
  </PropertyGroup>
 <ItemGroup><Compile Include="../Shared/UpdateProtocol.cs" Link="UpdateProtocol.cs"/><EmbeddedResource Include="../Shared/UpdatePublicKey.xml"><LogicalName>UpdatePublicKey.xml</LogicalName></EmbeddedResource></ItemGroup>
 <ItemGroup><Content Include="Launcher.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
